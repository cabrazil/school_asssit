# ============================================================
# School Assist — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env.
# ============================================================

# ---- Servidor -----------------------------------------------
PORT=3000
NODE_ENV=development
# Níveis: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Banco de Dados (Supabase / PostgreSQL) -----------------
# Usado pelo Prisma para queries (com PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Usado pelo Prisma para migrations (conexão direta)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---- WhatsApp / Baileys -------------------------------------
# Diretório onde a sessão autenticada será salva (não versionar!)
WA_SESSION_DIR=./wa-session
# Número do School Assist (formato: 5511999999999)
WA_BOT_PHONE=5511999999999
